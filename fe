package mysql;

import java.awt.*;
import java.awt.event.*;
import java.sql.*;
import javax.swing.*;

public class StudentMenuApp implements ActionListener {

    Frame f1;
    
    MenuBar menuBar;
    Menu operationsMenu;
    MenuItem insertStudentItem, getStudentItem, viewAllItem, exitItem;

    Panel mainPanel; 
    CardLayout cardLayout;

    Label l1, l2, l3, l4, l5, l6, l7, l8;
    TextField t1, t2, t3, t4, t5, t6, t7, t8;
    Button btnSubmit;

    Panel getStudentPanel;
    TextField tSearch;
    Button btnShow;
    TextArea taResult;

    Panel viewAllPanel;
    TextArea taAllStudents;

    Button btnExit;

    Connection con;
    PreparedStatement pst;

    public StudentMenuApp() {
        f1 = new Frame("Student");
        f1.setSize(500, 450);
        f1.setLayout(new BorderLayout());

        menuBar = new MenuBar();
        operationsMenu = new Menu("Operations");

        insertStudentItem = new MenuItem("Insert Student");
        getStudentItem = new MenuItem("Get Student Details");
        viewAllItem = new MenuItem("View All Students");
        exitItem = new MenuItem("Exit");

        operationsMenu.add(insertStudentItem);
        operationsMenu.add(getStudentItem);
        operationsMenu.add(viewAllItem);
        operationsMenu.add(exitItem);
        menuBar.add(operationsMenu);
        f1.setMenuBar(menuBar);

        cardLayout = new CardLayout();
        mainPanel = new Panel(cardLayout);

        Panel insertPanel = new Panel(new GridLayout(9, 2, 5, 5));

        l1 = new Label("Student ID:");
        l2 = new Label("Name:");
        l3 = new Label("Department:");
        l4 = new Label("Mark 1:");
        l5 = new Label("Mark 2:");
        l6 = new Label("Mark 3:");
        l7 = new Label("Total:");
        l8 = new Label("Percentage:");

        t1 = new TextField(10);
        t2 = new TextField(15);
        t3 = new TextField(10);
        t4 = new TextField(5);
        t5 = new TextField(5);
        t6 = new TextField(5);
        t7 = new TextField(10); t7.setEditable(false);
        t8 = new TextField(10); t8.setEditable(false);

        btnSubmit = new Button("Compute & Save");

        insertPanel.add(l1); insertPanel.add(t1);
        insertPanel.add(l2); insertPanel.add(t2);
        insertPanel.add(l3); insertPanel.add(t3);
        insertPanel.add(l4); insertPanel.add(t4);
        insertPanel.add(l5); insertPanel.add(t5);
        insertPanel.add(l6); insertPanel.add(t6);
        insertPanel.add(l7); insertPanel.add(t7);
        insertPanel.add(l8); insertPanel.add(t8);
        insertPanel.add(new Label(""));
        insertPanel.add(btnSubmit);

        mainPanel.add(insertPanel, "Insert");

        
        getStudentPanel = new Panel(new BorderLayout(5,5));
        Panel topPanel = new Panel(new FlowLayout());
        tSearch = new TextField(10);
        btnShow = new Button("Show Details");
        topPanel.add(new Label("Enter Student ID:"));
        topPanel.add(tSearch);
        topPanel.add(btnShow);

        taResult = new TextArea(10, 40);
        taResult.setEditable(false);

        getStudentPanel.add(topPanel, BorderLayout.NORTH);
        getStudentPanel.add(taResult, BorderLayout.CENTER);

        mainPanel.add(getStudentPanel, "GetStudent");

        
        viewAllPanel = new Panel(new BorderLayout(5,5));
        taAllStudents = new TextArea(20, 50);
        taAllStudents.setEditable(false);
        viewAllPanel.add(taAllStudents, BorderLayout.CENTER);
        mainPanel.add(viewAllPanel, "ViewAll");

       
        btnExit = new Button("Exit");
        Panel bottomPanel = new Panel();
        bottomPanel.add(btnExit);

        f1.add(mainPanel, BorderLayout.CENTER);
        f1.add(bottomPanel, BorderLayout.SOUTH);

        cardLayout.show(mainPanel, "Insert");
        f1.setVisible(true);

       
        connectDatabase();

       
        btnSubmit.addActionListener(this);
        btnExit.addActionListener(this);
        insertStudentItem.addActionListener(this);
        getStudentItem.addActionListener(this);
        viewAllItem.addActionListener(this);
        exitItem.addActionListener(this);
        btnShow.addActionListener(this);

        f1.addWindowListener(new WindowAdapter() {
            public void windowClosing(WindowEvent e) {
                System.exit(0);
            }
        });
    }

    
    public void actionPerformed(ActionEvent e) {
        Object src = e.getSource();

        if (src == btnSubmit) {
            insertStudentWithMarks();
        } 
        else if (src == btnExit || src == exitItem) {
            System.exit(0);
        } 
        else if (src == insertStudentItem) {
            cardLayout.show(mainPanel, "Insert");
        } 
        else if (src == getStudentItem) {
            cardLayout.show(mainPanel, "GetStudent");
        } 
        else if (src == viewAllItem) {
            showAllStudents();
        } 
        else if (src == btnShow) {
            showStudentDetails();
        }
    }

   
    void connectDatabase() {
        try {
            Class.forName("com.mysql.cj.jdbc.Driver");
            con = DriverManager.getConnection("jdbc:mysql://localhost:3306/myproject","root","");
            System.out.println("Database connected successfully!");
        } catch(Exception e) {
            JOptionPane.showMessageDialog(f1, "Database connection error: " + e.getMessage());
        }
    }

    
    void insertStudentWithMarks() {
        try {
            int id = Integer.parseInt(t1.getText());
            String name = t2.getText();
            String dept = t3.getText();
            int m1 = Integer.parseInt(t4.getText());
            int m2 = Integer.parseInt(t5.getText());
            int m3 = Integer.parseInt(t6.getText());

            if(m1>100 || m2>100 || m3>100){
                JOptionPane.showMessageDialog(f1,"Marks must be out of 100");
                return;
            }

            int total = m1 + m2 + m3;
            double percentage = total / 3.0;

            t7.setText(String.valueOf(total));
            t8.setText(String.format("%.2f", percentage));

            pst = con.prepareStatement(
                "INSERT INTO students (id,name,department,mark1,mark2,mark3,total,percentage) VALUES (?,?,?,?,?,?,?,?)"
            );
            pst.setInt(1, id);
            pst.setString(2, name);
            pst.setString(3, dept);
            pst.setInt(4, m1);
            pst.setInt(5, m2);
            pst.setInt(6, m3);
            pst.setInt(7, total);
            pst.setDouble(8, percentage);

            pst.executeUpdate();

            JOptionPane.showMessageDialog(f1,"Student and marks saved successfully!");

            t1.setText(""); t2.setText(""); t3.setText("");
            t4.setText(""); t5.setText(""); t6.setText("");
            t7.setText(""); t8.setText("");

        } catch(Exception e) {
            JOptionPane.showMessageDialog(f1,"Error: " + e.getMessage());
        }
    }

    
    void showStudentDetails() {
        try {
            String inputId = tSearch.getText();
            if(inputId == null || inputId.isEmpty()) return;

            int id = Integer.parseInt(inputId);
            pst = con.prepareStatement("SELECT * FROM students WHERE id=?");
            pst.setInt(1, id);

            ResultSet rs = pst.executeQuery();
            if(rs.next()) {
                String data = "ID: " + rs.getInt("id") + "\n\n" +
                              "Name: " + rs.getString("name") + "\n\n" +
                              "Department: " + rs.getString("department") + "\n\n" +
                              "Mark1: " + rs.getInt("mark1") + "\n\n" +
                              "Mark2: " + rs.getInt("mark2") + "\n\n" +
                              "Mark3: " + rs.getInt("mark3") + "\n\n" +
                              "Total: " + rs.getInt("total") + "\n\n" +
                              "Percentage: " + String.format("%.2f", rs.getDouble("percentage"));

                taResult.setText(data);
            } else {
                taResult.setText("No student found with ID " + id);
            }

        } catch(Exception e) {
            taResult.setText("Error: " + e.getMessage());
        }
    }

    void showAllStudents() {
        try {
            Statement stmt = con.createStatement();
            ResultSet rs = stmt.executeQuery("SELECT * FROM students");
            String data = "ID\t\t\tName\t\t\tDepartment\t\t\tMark1\t\t\tMark2\t\t\tMark3\t\t\tTotal\t\t\tPercentage\n\n";

            while(rs.next()) {
                data = data  
                    + rs.getInt("id") + "\t\t\t"
                    + rs.getString("name") + "\t\t\t"
                    + rs.getString("department") + "\t\t\t\t"
                    + rs.getInt("mark1") + "\t\t\t"
                    + rs.getInt("mark2") + "\t\t\t"
                    + rs.getInt("mark3") + "\t\t\t"
                    + rs.getInt("total") + "\t\t\t"
                    + String.format("%.2f", rs.getDouble("percentage")) + "\n\n";
            }

            taAllStudents.setText(data);
            cardLayout.show(mainPanel, "ViewAll");

        } catch(Exception e) {
            taAllStudents.setText("Error: " + e.getMessage());
        }
    }

    public static void main(String[] args) {
        new StudentMenuApp();
    }
}
